# 로컬 compose 전용 값 (S15P31A108-120). 개발용 더미라 커밋한다 — 서버·운영에 절대 쓰지 않는다.
# backend/compose.yaml·application-local.yml 의 로컬 기본값과 맞춰 두었다.
# 변수마다의 의미·필수 여부와 서버 env 파일의 키 목록은 docs/infra/env.md 에 있다 (S15P31A108-27).

DB_USERNAME=beez
DB_PASSWORD=beez

DOCUMENT_S3_ACCESS_KEY=beez-local-access
DOCUMENT_S3_SECRET_KEY=beez-local-secret

AI_INTERNAL_TOKEN=local-internal-token
# 임베딩·생성 호출을 확인할 때만 채운다. 실제 키는 이 파일에 쓰지 말고 셸 환경변수로 넘긴다.
GMS_KEY=

# 브라우저가 여는 주소. compose.local.yaml 의 nginx 포트와 같아야 한다
LOCAL_HTTP_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088

# 로컬 bootRun(8080)과 겹치지 않게 다른 포트로 연다
BACKEND_HOST_PORT=18080
