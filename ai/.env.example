# Copy to ai/.env (gitignored). Do not commit or paste real credentials.
GMS_KEY=
AI_INTERNAL_TOKEN=

# Optional: json_schema only when the configured provider/model supports strict output.
VALIDATION_RESPONSE_FORMAT=json_object

GMS_EMBEDDING_MODEL=text-embedding-3-small
# Initial AI configuration; BE must use the same model/dimension before indexing.
GMS_EMBEDDING_DIMENSION=1024

# Selected for the later Bibi generation task; #129 does not call these models.
BEE_DEFAULT_MODEL=gpt-6-luna
BEE_COMPLEX_MODEL=gpt-6.1-sol

# Enable only after BE accepts and persists DESIGN_RECOMMENDATION usage.
DESIGN_RECOMMENDATION_ENABLED=false

# Change impact analysis (#188). Supply an OpenAI-compatible Chat Completions
# endpoint, key, and model together. Never commit a real key.
IMPACT_LLM_ENDPOINT=
IMPACT_LLM_API_KEY=
IMPACT_LLM_MODEL=
# Keep below BE AI read timeout (default 20s) with serialization/network margin.
IMPACT_LLM_TIMEOUT_SECONDS=15
# Optional comma-separated response model aliases explicitly trusted by the caller.
IMPACT_LLM_ALLOWED_RESPONSE_MODELS=
# Use max_tokens only for providers/models requiring the legacy option.
IMPACT_LLM_OUTPUT_TOKEN_PARAMETER=max_completion_tokens
IMPACT_LLM_OUTPUT_TOKEN_LIMIT=1024
# json_schema requires a provider/model supporting OpenAI strict structured output.
IMPACT_LLM_RESPONSE_FORMAT=json_object
# Per-request limits; excess is rejected before invoking the provider.
IMPACT_MAX_BODY_BYTES=262144
IMPACT_MAX_ITEMS_PER_LIST=100
